# Copy to .env and adjust. docker-compose reads .env automatically.

# Host ports
WEB_PORT=3000
API_PORT=4000
POSTGRES_PORT=5432
REDIS_PORT=6379

# PostgreSQL (pgvector)
POSTGRES_USER=moddeck
POSTGRES_PASSWORD=moddeck
POSTGRES_DB=moddeck

# Used when running apps outside Docker (pnpm dev)
DATABASE_URL=postgresql://moddeck:moddeck@localhost:5432/moddeck
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
