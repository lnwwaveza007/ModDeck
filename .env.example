# Copy to .env and adjust. docker-compose reads .env automatically.

# Host ports
WEB_PORT=3000
API_PORT=4000
POSTGRES_PORT=5432
REDIS_PORT=6379

# PostgreSQL (pgvector)
POSTGRES_USER=moddeck
POSTGRES_PASSWORD=moddeck
POSTGRES_DB=moddeck

# Used when running apps outside Docker (pnpm dev)
DATABASE_URL=postgresql://moddeck:moddeck@localhost:5432/moddeck
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# KMUTT SSO (Microsoft Entra ID). Leave ENTRA_TENANT_ID empty to run without
# login; /api/auth/login then returns 503. The redirect URI to register in
# Entra is APP_BASE_URL + /api/auth/callback.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
APP_BASE_URL=http://localhost:3000
# Browsers keep Secure cookies on http://localhost, so this can stay true.
AUTH_COOKIE_SECURE=true
