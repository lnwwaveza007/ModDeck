<?xml version="1.0" encoding="UTF-8"?>
<!-- MD-21 spike: PowerPoint content add-in that shows a read-only ModDeck poll on a slide. -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="ContentApp">
  <Id>f0f0677d-a23e-40b0-863e-76afd4be20e7</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>ModDeck Team</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="ModDeck Poll (MD-21 spike)" />
  <Description DefaultValue="Shows a live, read-only ModDeck poll on a slide." />
  <IconUrl DefaultValue="https://localhost:3021/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://localhost:3021/assets/icon-64.png" />
  <SupportUrl DefaultValue="https://localhost:3021/" />
  <AppDomains>
    <AppDomain>https://localhost:3021</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Presentation" />
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3021/poll.html" />
    <RequestedWidth>800</RequestedWidth>
    <RequestedHeight>450</RequestedHeight>
  </DefaultSettings>
  <!-- Saving the poll PIN with Office.context.document.settings needs write access. -->
  <Permissions>ReadWriteDocument</Permissions>
  <AllowSnapshot>true</AllowSnapshot>
</OfficeApp>
